{
  "name": "biger-e2e-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Panel E2E — frontend en React/Vite/Tailwind. Habla con ui/server.js (/api/*), que sigue siendo el único que ejecuta ./e2e.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
